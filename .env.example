# Optional backend base URL. Only public configuration belongs in VITE_* variables.
VITE_API_BASE_URL=
# Public Q5 API origin. Empty uses the Vite development proxy / same-origin production proxy.
VITE_REVIEW_API_BASE_URL=
# Spring 백엔드 개발 프록시 대상. 비우면 http://localhost:8080 (다른 노트북 서버면 그 IP)
VITE_API_PROXY=
# true면 서버 없이 목 데이터로 동작 (주소에 ?mock 을 붙여도 켜짐, ?mock=off 로 끔)
VITE_API_MOCK=
